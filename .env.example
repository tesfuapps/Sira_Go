# Sira Go Environment Configuration Example
# Copy this file to .env and provide your credentials

# Telegram Bot & Channel Configuration
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHANNEL_ID=@sira_go
VITE_TELEGRAM_BOT_USERNAME=sirago_jobs_bot

# Application URL (Used for deep links, Telegram Mini App menu, and sharing)
APP_URL="https://sirago.et"

# Firebase Client Configuration (Optional overrides; defaults loaded from firebase-applet-config.json)
FIREBASE_PROJECT_ID=
